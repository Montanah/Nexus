# Copy this file to backend/.env and fill in the blank values.
# .env is ignored by Git. Keep service credentials in that local file.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
APP_URL=http://localhost:5173

# Use a running local MongoDB instance or your development Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/nexus

# Generate a different random value for each secret: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# In Upstash Console, select your Redis database and open Connect > REST.
# This project uses the names below, WITHOUT "_REST" in the variable names.
# UPSTASH_REDIS_URL receives UPSTASH_REDIS_REST_URL (the https:// endpoint).
# UPSTASH_REDIS_TOKEN receives UPSTASH_REDIS_REST_TOKEN (the read/write token).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Verification emails use Gmail. Supply the sender account and its app password.
EMAIL_USER=
EMAIL_PASS=

# The current server initializes Google and Apple strategies during startup,
# even when you only intend to test email/password login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL_LOGIN=http://localhost:3001/api/auth/google/login/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_FILE_PATH=
APPLE_CALLBACK_URL=

# Stripe is also initialized during startup. Use a Stripe test secret key.
# Other payment-provider settings are only needed when testing those providers.
STRIPE_SECRET_KEY=
